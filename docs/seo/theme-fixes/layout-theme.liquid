		{%- comment -%} SEO fix 10/2026: conversion_event_submit_lead_form removed from here (it fired on every page view). Fire it only after a successful form submit. {%- endcomment -%}

		<link rel="shortcut icon" href="{{ 'favicon.png' | asset_url }}" type="image/png" />
		<title>
			{{ page_title | strip_newlines | strip_html  | escape }} {% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
		</title>
		{%- unless template contains '404' -%}
		{%- assign seo_canonical = canonical_url -%}
		{%- if current_page > 1 -%}{%- assign seo_canonical = canonical_url | append: '?page=' | append: current_page -%}{%- endif -%}
		<link rel="canonical" href="{{ seo_canonical }}" />
		<link rel="alternate" href="{{ seo_canonical }}" hreflang="vi-vn" />
		{%- endunless -%}
		{%- assign seo_robots = '' -%}
		{%- if template contains 'article' -%}
		{%- if robots contains 'noindex' or robots contains 'nofollow' -%}{%- assign seo_robots = robots -%}{%- endif -%}
		{%- endif -%}
		{%- if template contains 'search' or template contains '404' or current_tags -%}{%- assign seo_robots = 'noindex,follow' -%}{%- endif -%}
		{%- if template contains 'collection' -%}
		{%- if collection.handle == 'all' or collection.handle == 'frontpage' or collection.handle == 'onsale' or collection.handle == 'hot-products' or collection.handle == 'types' or collection.handle == 'vendors' -%}{%- assign seo_robots = 'noindex,follow' -%}{%- endif -%}
		{%- if canonical_url contains '/collections/types' or canonical_url contains '/collections/vendors' -%}{%- assign seo_robots = 'noindex,follow' -%}{%- endif -%}
		{%- endif -%}
		{%- if template contains 'page' and page.handle == 'frontpage' -%}{%- assign seo_robots = 'noindex,follow' -%}{%- endif -%}
		{%- if seo_robots != '' -%}
		<meta name="robots" content="{{ seo_robots }}">
		{%- endif -%}
		{%- comment -%} SEO fix 10/2026: inline jQuery 3.5.1 (89 KB) removed. master-include already loads jquery-3.5.1.min.js synchronously before any jQuery code. {%- endcomment -%}
		{% include 'master-include' %}
		{% include 'optimize_head' %}
		{% include 'fb-open-graph-tags' %}
		{% include 'seo_head' %}

		{%- capture capserverHead -%}{{ content_for_header }}{%- endcapture -%}
		{%- assign syntax1 = "//<![CDATA["-%}
	{%- assign syntax2 = "//]]>"-%}
		{%- assign syntax1_new = "if(f1genzPS){"-%}
		{%- assign syntax2_new = "}"-%}
		{%- assign flagHead = capserverHead | replace: syntax1, syntax1_new | replace: syntax2, syntax2_new -%}
		{%- assign shoptheme = flagHead | split: 'Haravan.theme = {"name":"' | last -%}
		{%- assign shoptheme = shoptheme | split: '","id":' | first -%}
		{%- capture stylenofity -%}<link href='//hstatic.net/0/0/global/notification.css' rel='stylesheet'/>{%- endcapture -%}
		{%- capture jsnofity -%}<script data-value='{{ shoptheme }}' src='//hstatic.net/0/0/global/notification.js'></script>{%- endcapture -%}
		{%- capture gtagOnceOld -%}src='https://www.googletagmanager.com/gtag/js{%- endcapture -%}
		{%- capture gtagOnceNew -%}id="thisIsGtagOnce" nosrc='https://www.googletagmanager.com/gtag/js{%- endcapture -%}
		{%- capture gtagDoubOld -%}src="https://www.googletagmanager.com/gtag/js{%- endcapture -%}
		{%- capture gtagDoubNew -%}id="thisIsGtagDoub" nosrc="https://www.googletagmanager.com/gtag/js{%- endcapture -%}
		{%- capture beaconOld -%}src='https://stats.hstatic.net/beacon.min.js'{%- endcapture -%}
		{%- capture beaconNew -%}id="thisIsBeacon" nosrc='https://stats.hstatic.net/beacon.min.js'{%- endcapture -%}
		{%- assign serverHead = flagHead | replace:  remove: stylenofity | remove: jsnofity | replace: gtagOnceOld, gtagOnceNew | replace: gtagDoubOld, gtagDoubNew | replace: beaconOld, beaconNew -%}

		{%- capture capsrcCombo1 -%}"https://combo-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
		{%- assign srcCombo1 = capsrcCombo1 -%}
		{%- capture capsrcCombo2 -%}"https://combo-omni.haravan.com/js/script_tag_production.js?v=1576487994026",{%-endcapture-%}
		{%- capture capsrcCombo3 -%},"https://combo-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
		{%- assign srcCombo2 = capsrcCombo2 -%}
		{%- assign srcCombo3 = capsrcCombo3 -%}

		{%- capture capsrcBuyXY1 -%}"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
		{%- assign srcBuyXY1 = capsrcBuyXY1 -%}
		{%- capture capsrcBuyXY2 -%}"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1576487994026",{%-endcapture-%}
		{%- capture capsrcBuyXY3 -%},"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1576487994026"{%-endcapture-%}
		{%- assign srcBuyXY2 = capsrcBuyXY2 -%}
		{%- assign srcBuyXY3 = capsrcBuyXY3 -%}

		{%- capture capsrcBuy2Get1_1 -%}"https://promotionsme-apps.haravan.com/api/buyer/script_tag/buy2get1"{%-endcapture-%}
		{%- assign srcBuy2Get1_1 = capsrcBuy2Get1_1 -%}
		{%- capture capsrcBuy2Get1_2 -%}"https://promotionsme-apps.haravan.com/api/buyer/script_tag/buy2get1",{%-endcapture-%}
		{%- capture capsrcBuy2Get1_3 -%},"https://promotionsme-apps.haravan.com/api/buyer/script_tag/buy2get1"{%-endcapture-%}
		{%- assign srcBuy2Get1_2 = capsrcBuy2Get1_2 -%}
		{%- assign srcBuy2Get1_3 = capsrcBuy2Get1_3 -%}

		{%- capture capsrcCombo_final1 -%}"https://combo-omni.haravan.com/js/script_tag_production.js?v=1003"{%-endcapture-%}
		{%- assign srcCombo_final1 = capsrcCombo_final1 -%}

		{%- capture capsrcBuyXY_final1 -%}"https://buyxgety-omni.haravan.com/js/script_tag_production.js?v=1002"{%-endcapture-%}
		{%- assign srcBuyXY_final1 = capsrcBuyXY_final1 -%}

		{%- capture capsrcBuy2Get1_final1 -%}"https://promotionsme-apps.haravan.com/api/buyer/script_tag/buy2get1"{%-endcapture-%}
		{%- assign srcBuy2Get1_final1 = capsrcBuy2Get1_final1 -%}

		{%- if settings.promotion_hrvapp_use -%}
		{%-if settings.promotion_hrvapp == 'appcombo'-%}
		{%-capture srcHead -%}{{ serverHead | remove: srcBuyXY2 | remove: srcBuyXY3 | remove: srcBuy2Get1_2 | remove: srcBuy2Get1_3 }}{%- endcapture -%}
		{{ srcHead  }}
		{%- elsif settings.promotion_hrvapp == 'appbuyxgety' -%}
		{%-capture srcHead -%}{{ serverHead | remove: srcCombo2 | remove: srcCombo3 | remove: srcBuy2Get1_2 | remove: srcBuy2Get1_3 }}{%- endcapture -%}
		{{ srcHead }}
		{%- elsif settings.promotion_hrvapp == 'appbuy2get1' -%}
		{%-capture srcHead -%}{{ serverHead | remove: srcBuyXY2 | remove: srcBuyXY3 | remove: srcCombo2 | remove: srcCombo3  }}{%- endcapture -%}
		{{ srcHead }}
		{%-endif-%}
		{%-else-%}
		{{ serverHead | remove: srcBuyXY2 | remove: srcBuyXY3 | remove: srcCombo2 | remove: srcCombo3 | remove: srcBuy2Get1_2 | remove: srcBuy2Get1_3 }}
		{%-endif-%}
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Organization",
					"@id": "{{ shop.url }}/#organization",
					"name": "Todaytec Việt Nam",
					"url": "{{ shop.url }}/",
					"logo": "https:{{ 'logo.png' | asset_url }}",
					"telephone": "+84919896357",
					"address": {
						"@type": "PostalAddress",
						"streetAddress": "Số 199 Hồ Học Lãm, Phường An Lạc, Quận Bình Tân",
						"addressLocality": "Hồ Chí Minh",
						"addressCountry": "VN"
					},
					"contactPoint": {
						"@type": "ContactPoint",
						"telephone": "+84919896357",
						"contactType": "sales",
						"areaServed": "VN",
						"availableLanguage": ["vi", "en"]
					},
					"sameAs": [
						"https://www.facebook.com/profile.php?id=61573489677238",
						"https://www.linkedin.com/company/todaytecvietnam/",
						"https://www.youtube.com/@TodaytecVietnam"
					],
					"parentOrganization": {
						"@type": "Organization",
						"name": "Hangzhou Todaytec Digital Technology",
						"url": "https://todaytec.com/"
					}
				},
				{
					"@type": "WebSite",
					"@id": "{{ shop.url }}/#website",
					"name": "Todaytec Việt Nam",
					"url": "{{ shop.url }}/",
					"inLanguage": "vi-VN",
					"publisher": { "@id": "{{ shop.url }}/#organization" }
				}
			]
		}
		</script>
	</head>
	<body class="mainBody-theme {% if  cart.item_count > 0 %} mainBody-mbcart {% endif %} {% if customer %}customer-logged-in {% endif %}template-{{ template | replace: '.', ' ' | truncatewords: 1, '' | handle }}">
		<div class="mainBody-theme-container mainBody-modalshow  {% if template contains 'product'%} mainBody-product {% endif%} {% if template contains 'cart'%} mainBody-cart {% endif%} {% if settings.addthis_iconList_show %} layoutProduct_scroll {% endif %}">
			{%- include 'header' -%}
			<main class="wrapperMain_content">	{{ content_for_layout }}		</main>
			{%- include 'footer' -%}
			<div id="sitenav-overlay" class="sitenav-overlay"></div>

			{%- if template contains 'index' -%}	{%- include 'popup-contact' -%}		{%- endif -%}
			{%- include 'modal-live' -%}
		</div>
		<div onclick="HRT.All.scrollToTop(100);" class="back_top d-flex position-fixed justify-content-center align-items-center">
			<img alt="Lên đầu trang" src="https://file.hstatic.net/200000930815/file/to-top-arrow2.webp">
		</div>
		{% include "multilanguage" %}
		{%- include 'quickview' -%}
		{%- include 'modal-coupon' -%}
		{%- include 'sidebar-main' -%}
		{%- include 'addthis-sharing' -%}
		{%- include 'footer-scripts' -%}


